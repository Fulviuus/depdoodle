{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DepDoodle",
  "version": "0.3.0",
  "identifier": "com.fulvio.depdoodle",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DepDoodle",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/depdoodle-d2"
    ],
    "resources": {
      "../node_modules/@d2lang/d2/LICENSE.txt": "licenses/D2-LICENSE.txt",
      "../node_modules/@d2lang/d2/THIRD_PARTY_NOTICES.txt": "licenses/D2-THIRD-PARTY-NOTICES.txt"
    }
  }
}
